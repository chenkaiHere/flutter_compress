<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets compression continue while the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- saveToDownloads(): MediaStore needs no permission on Android 10+ (API
         29+); only Android 9 and below writes to the public Downloads folder
         directly and needs this legacy permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <service
            android:name=".CompressionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
